# StudentAI.com Environment Configuration

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database Configuration (SQLite for local development, PostgreSQL compatible)
DATABASE_URL=sqlite:///./studentai.db

# Security & JWT Configuration
SECRET_KEY=studentai-secret-development-key-2026-secure-jwt
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Campus Timezone (Default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# File Storage
STORAGE_DIR=storage/timetables
MAX_UPLOAD_SIZE_MB=25

