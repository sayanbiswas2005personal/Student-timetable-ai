# ---------------------------------------------------------------------------
# Backend configuration. Copy to backend/.env and adjust, or export these
# variables in your shell. Nothing here is a real secret: replace every value.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Host, port and schema of the MySQL 8 database.
DB_URL=jdbc:mysql://localhost:3306/college_timetable?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata&characterEncoding=utf8
DB_USERNAME=timetable_app
DB_PASSWORD=replace-with-the-database-password
DB_POOL_SIZE=10

# College -------------------------------------------------------------------
COLLEGE_NAME=College Timetable Lookup System
# IANA timezone used for every date and time calculation in the backend.
COLLEGE_TIMEZONE=Asia/Kolkata

# Server --------------------------------------------------------------------
SERVER_PORT=8080
SESSION_TIMEOUT=8h
# Set to true when the API is served over HTTPS so the session cookie is secure.
SESSION_COOKIE_SECURE=false

# First administrator -------------------------------------------------------
# Public registration is disabled. Start once with these set, then remove them.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Synthetic demo data -------------------------------------------------------
# Loads clearly labelled TEST DATA so the lookup workflow can be tried out.
# Never enable against real college data.
SEED_DEMO_DATA=false

# Security ------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW=5m
RATE_LIMIT_LOOKUP_REQUESTS=240
RATE_LIMIT_LOOKUP_WINDOW=1m
# Comma separated. Leave empty in development: the Vite dev server proxies /api,
# so browser requests are same origin and CORS is not involved.
CORS_ALLOWED_ORIGINS=

# PDF import ----------------------------------------------------------------
IMPORT_DIR=./data/imports
IMPORT_MAX_FILE_SIZE=25MB
IMPORT_MAX_PAGES=100
# A page with fewer extracted characters than this is treated as needing OCR.
IMPORT_MIN_CHARS_PER_PAGE=40

# OCR (optional) ------------------------------------------------------------
# When a scanned PDF has no embedded text, the backend can call a separate OCR
# service. Leave disabled until that service is running; the import is then left
# in OCR_PENDING with the pages that need attention, never silently accepted.
OCR_ENABLED=false
OCR_BASE_URL=http://localhost:8081
OCR_TIMEOUT_SECONDS=120

# Logging -------------------------------------------------------------------
LOG_LEVEL=INFO