# ---------------------------------------------------------------------------
# Frontend configuration. Copy to frontend/.env.local and adjust.
# Never put a secret here: everything in the browser is public.
# ---------------------------------------------------------------------------

# Base URL of the timetable API.
#
# Leave this as /api in development. The Vite dev server proxies /api to the
# backend, so the browser only ever talks to one origin, which keeps the session
# cookie and CSRF protection working without any CORS configuration.
#
# For a production build served from a different host than the API, set the full
# URL, for example https://api.college.example.in/api, and add that frontend
# origin to CORS_ALLOWED_ORIGINS in the backend configuration.
VITE_API_BASE_URL=/api

# Port the Vite dev server listens on.
VITE_PORT=5173

# Port the backend listens on. Used only by the development proxy.
VITE_BACKEND_PORT=8080
